<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Phone (10 digits)"
            android:inputType="phone"
            android:maxLength="10"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Course (e.g., B.Tech CSE)"
            android:inputType="text"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Year (e.g., 3rd Year)"
            android:inputType="text"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etBuilding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Building (e.g., Block A)"
            android:inputType="text"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etHostel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Hostel / PG"
            android:inputType="text"
            android:background="@drawable/bg_input"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Save Profile"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button" />

    </LinearLayout>
</ScrollView>